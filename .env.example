# ---------------------------------------------------------------------------
# Optional configuration. Copy this file to `.env` and fill in what you need.
# Every value below is OPTIONAL - the portfolio works with sensible defaults.
# ---------------------------------------------------------------------------

# GitHub username used to load public repositories.
# Default when omitted: ssvahya1 -> (see src/data/site.js)
VITE_GITHUB_USERNAME=ssyahya1

# Optional GitHub personal access token.
# Unauthenticated GitHub API calls are limited to 60 requests per hour per IP.
# A token raises that to 5,000/hour. Use a token with NO scopes (public read
# only) because anything in a Vite env file is shipped to the browser.
# VITE_GITHUB_TOKEN=

# Contact details (leave empty to keep the placeholder state in the UI).
VITE_CONTACT_EMAIL=
VITE_LINKEDIN_URL=

# Local admin passcode for the editing mode.
# This is a convenience gate for the local/static version only - it is NOT real
# security. Replace it with real authentication once the backend exists.
VITE_ADMIN_PASSCODE=let-me-edit